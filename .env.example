# Banco de dados PostgreSQL
# Docker: postgresql://fervor:fervor@localhost:5432/fervor
DATABASE_URL=postgresql://user:password@localhost:5432/fervor

# JWT (gere com: openssl rand -hex 32)
JWT_SECRET=your-secret-key-at-least-32-chars

# API OpenAI (para o chat Fervor com GPT)
OPENAI_API_KEY=sk-...

# Modelo (opcional, padrão: gpt-4o)
OPENAI_MODEL=gpt-4o
